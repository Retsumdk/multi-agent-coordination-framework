{
  "name": "multi-agent-coordination-framework",
  "version": "1.0.0",
  "description": "Coordination framework for multiple autonomous agents: versioned shared state with optimistic concurrency, TTL leases, deterministic conflict resolution, capability-matched task distribution, and an append-only event log",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "bin": {
    "macf": "./dist/cli-run.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "multi-agent",
    "agents",
    "coordination",
    "shared-state",
    "conflict-resolution",
    "leases",
    "task-distribution",
    "optimistic-concurrency",
    "event-log",
    "typescript"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "demo": "node dist/cli-run.js demo",
    "prepare": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/multi-agent-coordination-framework.git"
  },
  "bugs": {
    "url": "https://github.com/Retsumdk/multi-agent-coordination-framework/issues"
  },
  "homepage": "https://github.com/Retsumdk/multi-agent-coordination-framework#readme",
  "devDependencies": {
    "@types/node": "22",
    "bun-types": "^1.4.3",
    "typescript": "^5.7.2"
  }
}
